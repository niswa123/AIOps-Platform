  },
  "peerDependencies": {
    "openai": ">=4.0.0",
    "ai": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "openai": { "optional": true },
    "ai": { "optional": true }
  },
  "engines": {
    "node": ">=18.0.0"
